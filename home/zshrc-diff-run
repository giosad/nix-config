#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "Usage: zshrc-diff-run <command> [args...]" >&2
  exit 2
fi

orig_zshrc="$HOME/.zshrc"
backup_dir="$(mktemp -d)"
backup_file="$backup_dir/.zshrc.backup"
backup_link="$backup_dir/.zshrc.link"

cleanup() {
  # Restore original state
  if [ -f "$backup_link" ]; then
    ln -sf "$(cat "$backup_link")" "$orig_zshrc"
  elif [ -f "$backup_file" ]; then
    cp "$backup_file" "$orig_zshrc"
  fi
  rm -rf "$backup_dir"
}
trap cleanup EXIT

# Save original state and make writable
if [ -L "$orig_zshrc" ]; then
  readlink "$orig_zshrc" > "$backup_link"
  cp "$orig_zshrc" "$backup_file"
  rm "$orig_zshrc"
  cp "$backup_file" "$orig_zshrc"
  chmod u+w "$orig_zshrc"
elif [ -f "$orig_zshrc" ]; then
  cp "$orig_zshrc" "$backup_file"
  chmod u+w "$orig_zshrc"
else
  : > "$backup_file"
fi

cmd_status=0
diff_status=0

set +e
"$@"
cmd_status=$?

diff -u --label "original" --label "modified" "$backup_file" "$orig_zshrc"
diff_status=$?
set -e

if [ "$diff_status" -eq 0 ]; then
  echo "No changes to .zshrc"
elif [ "$diff_status" -ne 1 ]; then
  echo "Error: diff failed" >&2
  exit 2
fi

exit "$cmd_status"
